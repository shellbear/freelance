{
  "name": "freelance-stats",
  "private": true,
  "type": "module",
  "scripts": {
    "fetch": "bun pipeline/fetch.ts",
    "build": "bun pipeline/build.ts && bun run build:site",
    "build:site": "bun build src/app.ts --outdir public --minify",
    "dev": "bun run build:site && bunx wrangler@4 dev",
    "verify": "bun fmt --check src pipeline public/index.html README.md && bun check && bun test"
  },
  "dependencies": {
    "@duckdb/node-api": "2.0.0-r.1",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4"
  }
}
